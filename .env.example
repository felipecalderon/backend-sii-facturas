# Configuración de Base de Datos MongoDB
MONGODB_URI=mongodb://localhost:27017/sii_facturas

# Puerto del servidor
PORT=3000

# Clave maestra de 32 bytes (64 caracteres hexadecimales) para cifrado AES-256-GCM de certificados
CERTIFICATE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
